rules_version = '2';

// Who may read and write what in Mixly's shared database.
//
// These rules are the whole of the security: the app's code runs on people's
// phones and could be changed by anyone, so nothing it does is trusted. Every
// promise the app makes about privacy — a private recipe stays private, only
// friends see what you share, nobody becomes your friend without you saying
// yes — is made here.
//
//   profiles/{uid}              your display name, username and friend code
//   usernames/{lowercased}      who owns a username; makes them unique
//   friendCodes/{code}          who owns a friend code; makes them unique
//   requests/{from}_{to}        a friend request waiting for an answer
//   friendships/{a}_{b}         two people who are friends (a < b)
//   users/{uid}/shared/{id}     a recipe you chose to share with friends

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Reading other people and making friends needs a confirmed address.
    // Accounts sign in with Google, whose addresses always are; the check
    // stays so that no other way in can skip it.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function me() {
      return request.auth.uid;
    }

    function friends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(a + '_' + b))
          || exists(/databases/$(database)/documents/friendships/$(b + '_' + a));
    }

    function validNames(p) {
      return p.usernameLower == p.username.lower()
        && p.displayName is string
        && p.displayName.size() >= 1
        && p.displayName.size() <= 40;
    }

    function hasProfile(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid));
    }

    // ---- profile ---------------------------------------------------------

    match /profiles/{uid} {
      // Friends and people sending you requests need your name.
      allow read: if signedIn() && (uid == me() || verified());

      // Made once, together with the username and code it names, in the same
      // write — so a profile can only claim a name and a code its owner holds.
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'displayName', 'friendCode', 'createdAt'])
        && validNames(request.resource.data)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == me()
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == me();

      // The display name can change freely. The username can too, but only
      // by holding the new one and letting go of the old one in the same
      // write — so nobody ends up sitting on two names. The friend code
      // never changes.
      allow update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'displayName', 'friendCode', 'createdAt'])
        && request.resource.data.friendCode == resource.data.friendCode
        && request.resource.data.createdAt == resource.data.createdAt
        && validNames(request.resource.data)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == me()
        && (request.resource.data.usernameLower == resource.data.usernameLower
          || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.usernameLower)));

      allow delete: if signedIn() && uid == me();
    }

    // ---- the two lookups that make names and codes unique ------------------

    match /usernames/{name} {
      // Looking one name up is open, so "is this name free?" can be answered
      // before an account exists. Listing them all is not.
      allow get: if true;
      allow list: if false;
      // "create" only ever succeeds on a name nobody holds, and there is no
      // update, so a name cannot be taken from its owner. Letting go of it —
      // on a rename, or when the account closes — is the only way it frees.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && name.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && code.matches('^[A-Z2-9]{8}$');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ---- friend requests -------------------------------------------------

    match /requests/{id} {
      allow read: if verified()
        && (resource.data.from == me() || resource.data.to == me());

      // Only in your own name, never to yourself, not to someone who is
      // already a friend, and filed under the id that says who and to whom.
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'createdAt'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && hasProfile(request.resource.data.to)
        && request.resource.data.fromName == get(/databases/$(database)/documents/profiles/$(me())).data.username
        && !friends(me(), request.resource.data.to);

      // Either side can withdraw or answer it; answering removes it.
      allow delete: if verified()
        && (resource.data.from == me() || resource.data.to == me());
    }

    // ---- friendships -----------------------------------------------------

    match /friendships/{id} {
      allow read: if verified() && me() in resource.data.members;

      // Only the person who was asked can say yes, and only while the request
      // that asked them is still there.
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.members[0] < request.resource.data.members[1]
        && (
          (request.resource.data.members[0] == me()
            && exists(/databases/$(database)/documents/requests/$(request.resource.data.members[1] + '_' + me())))
          || (request.resource.data.members[1] == me()
            && exists(/databases/$(database)/documents/requests/$(request.resource.data.members[0] + '_' + me())))
        );

      // Either friend can end it.
      allow delete: if verified() && me() in resource.data.members;
    }

    // ---- shared recipes --------------------------------------------------

    match /users/{uid}/shared/{recipeId} {
      allow read: if verified() && (uid == me() || friends(me(), uid));
      allow create, update: if verified() && uid == me()
        && request.resource.data.owner == me();
      // Deleting needs no confirmed address, so an account can always be
      // cleared out on its way to being closed.
      allow delete: if signedIn() && uid == me();
    }
  }
}
